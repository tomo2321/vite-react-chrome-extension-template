{
  "name": "vite-react-chrome-extension-template",
  "private": true,
  "version": "0.0.0",
  "description": "Vite + React template for Chrome Extension development.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:storybook": "vitest run --project=storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "fmt": "dprint fmt",
    "format:md": "dprint fmt '**/*.md'",
    "prepare": "husky",
    "setup": "pnpm install && pnpm exec playwright install chromium",
    "generate-icon": "tsx scripts/generate-icon.ts"
  },
  "keywords": [
    "vite",
    "react",
    "typescript",
    "chrome-extension",
    "browser-extension",
    "tailwindcss",
    "template",
    "boilerplate",
    "crxjs"
  ],
  "author": "author",
  "packageManager": "pnpm@12.20.0",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@crxjs/vite-plugin": "^3.0.0",
    "@dprint/json": "^0.26.0",
    "@dprint/markdown": "^0.29.0",
    "@dprint/typescript": "^0.100.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-onboarding": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "commander": "^15.1.0",
    "dprint": "^0.64.3",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.24.1",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css}": [
      "biome check --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix",
      "dprint fmt --allow-no-files"
    ],
    "*.{yml,yaml}": [
      "dprint fmt --allow-no-files"
    ]
  },
  "engines": {
    "node": "26.x"
  }
}
